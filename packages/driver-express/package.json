{
    "name": "@arkstack/driver-express",
    "version": "0.4.3",
    "type": "module",
    "description": "Express driver package for Arkstack providing Express-specific implementations of core Arkstack features such as routing, middleware, and database integration.",
    "homepage": "https://arkstack.toneflix.net",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arkstack-hq/arkstack.git",
        "directory": "packages/driver-express"
    },
    "keywords": [
        "express",
        "driver",
        "integration",
        "routing",
        "middleware",
        "database",
        "arkstack",
        "http",
        "server",
        "rest",
        "api",
        "framework"
    ],
    "files": [
        "dist",
        "stubs"
    ],
    "scripts": {
        "build": "tsdown",
        "version:patch": "pnpm version patch",
        "prepublishOnly": "node ../../scripts/prepublish-only.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./dist/index.js",
        "./middlewares": "./dist/middlewares/index.js",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "clear-router": "^2.6.0",
        "@arkstack/contract": "workspace:^",
        "express-rate-limit": "^8.4.1",
        "@resora/plugin-clear-router": "^1.0.10",
        "resora": "^1.2.0"
    },
    "peerDependencies": {
        "@arkstack/auth": "workspace:^",
        "@arkstack/common": "workspace:^",
        "express": "^5.2.1"
    },
    "peerDependenciesMeta": {
        "@arkstack/auth": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/express": "^5.0.6"
    }
}