{
    "name": "@arkstack/driver-h3",
    "version": "0.3.16",
    "type": "module",
    "description": "H3 driver package for Arkstack providing H3-specific implementations of core Arkstack features such as routing, middleware, and database integration.",
    "homepage": "https://arkstack.toneflix.net",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arkstack-hq/arkstack.git",
        "directory": "packages/driver-h3"
    },
    "keywords": [
        "h3",
        "driver",
        "integration",
        "routing",
        "middleware",
        "database",
        "arkstack",
        "http",
        "server",
        "rest",
        "api",
        "framework"
    ],
    "files": [
        "dist",
        "stubs"
    ],
    "scripts": {
        "build": "tsdown",
        "version:patch": "pnpm version patch",
        "prepublishOnly": "pnpm build"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./dist/index.js",
        "./middlewares": "./dist/middlewares/index.js",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@arkstack/contract": "workspace:^"
    },
    "peerDependencies": {
        "@arkstack/auth": "workspace:^",
        "@arkstack/common": "workspace:^",
        "clear-router": "^2.3.3",
        "h3": "2.0.1-rc.16"
    },
    "peerDependenciesMeta": {
        "@arkstack/auth": {
            "optional": true
        }
    }
}
