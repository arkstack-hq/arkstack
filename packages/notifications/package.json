    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@arkstack/common": "workspace:^",
        "africastalking": "^0.8.0",
        "nodemailer": "^8.0.7",
        "twilio": "^6.0.0"
    },
    "peerDependencies": {
        "arkormx": "^2.0.7"
    },
    "devDependencies": {
        "@types/nodemailer": "^7.0.11"
    }
}
