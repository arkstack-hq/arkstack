{
    "name": "@arkstack/common",
    "version": "0.5.2",
    "type": "module",
    "description": "Shared foundations and core utilities for Arkstack applications and packages.",
    "homepage": "https://arkstack.toneflix.net",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arkstack-hq/arkstack.git",
        "directory": "packages/common"
    },
    "keywords": [
        "common",
        "utilities",
        "helpers",
        "logging",
        "configuration",
        "error-handling",
        "validation",
        "arkstack"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown --config-loader unrun",
        "version:patch": "pnpm version patch",
        "prepublishOnly": "node ../../scripts/prepublish-only.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "jiti": "^2.7.0",
        "bcryptjs": "^3.0.3",
        "chalk": "^5.6.2",
        "detect-port": "^2.1.0",
        "otpauth": "^9.5.1",
        "pino": "^10.3.1"
    },
    "peerDependencies": {
        "@h3ravel/support": "^0.15.11",
        "arkormx": "^2.0.11"
    }
}
