{
    "name": "@arkstack/filesystem",
    "version": "0.4.0",
    "type": "module",
    "description": "Shared Filesystem utilities for ArkStack.",
    "homepage": "https://arkstack.toneflix.net",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arkstack-hq/arkstack.git",
        "directory": "packages/filesystem"
    },
    "keywords": [
        "filesystem",
        "storage",
        "utilities",
        "interface",
        "runtime",
        "application",
        "framework",
        "flydrive"
    ],
