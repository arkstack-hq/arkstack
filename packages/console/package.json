{
    "name": "@arkstack/console",
    "version": "0.7.15",
    "type": "module",
    "description": "Console module for Arkstack, providing the command-line runtime and console integration layer.",
    "homepage": "https://arkstack.toneflix.net/guide/cli",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arkstack-tmp/arkstack.git",
        "directory": "packages/console"
    },
    "keywords": [
        "console",
        "cli",
        "command-line",
        "interface",
        "runtime",
        "application",
        "framework",
        "stubs",
        "musket",
        "h3ravel"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "version:patch": "pnpm version patch",
        "prepublishOnly": "node ../../scripts/prepublish-only.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "ark": "./dist/index.js",
        "prepare": "./dist/prepare.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./app": {
            "types": "./dist/app.d.ts",
            "import": "./dist/app.js"
        }
    },
    "peerDependencies": {
        "clear-router": "^2.6.7",
        "arkormx": "^ 2.4.0"
    },
    "dependencies": {
        "@arkstack/common": "workspace:^",
        "@arkstack/contract": "workspace:^",
        "@h3ravel/musket": "^0.10.1",
        "@h3ravel/support": "^0.15.11",
        "chalk": "^5.6.2",
        "resora": "^1.3.5"
    }
}