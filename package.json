{
  "name": "arkstack",
  "type": "module",
  "version": "0.12.21",
  "publishConfig": {
    "access": "restricted"
  },
  "private": "true",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "build:templates": "pnpm -r --filter \"*-app\" build",
    "build:packages": "pnpm -r --filter \"@arkstack/*\" build",
    "prepare:release-version": "node scripts/prepare-release-version.mjs",
    "publish:packages": "pnpm -r --filter \"@arkstack/*\" --filter create-arkstack publish --access public",
    "dev": "tsdown --silent",
    "build": "NODE_ENV=production pnpm -r --filter \"@arkstack/*\" --filter \"h3\" --filter \"express\" build",
    "cmd": "tsx src/core/commands/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@arkstack/auth": "workspace:^",
    "@arkstack/common": "workspace:^",
    "@arkstack/driver-express": "workspace:^",
    "@arkstack/driver-h3": "workspace:^",
    "@arkstack/http": "workspace:^",
    "@arkstack/notifications": "workspace:^",
    "@arkstack/view": "workspace:^",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.1",
    "@faker-js/faker": "^10.4.0",
    "@rollup/plugin-run": "^3.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.28",
    "@vitest/coverage-v8": "^4.1.5",
    "arkormx": "^2.5.6",
    "clear-router": "^2.8.6",
    "dotenv": "^17.3.1",
    "escalade": "^3.2.0",
    "eslint": "^10.3.0",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "h3": "2.0.1-rc.22",
    "jose": "^6.2.3",
    "kysely": "^0.28.15",
    "parasito": "^0.2.3",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "resora": "^1.3.16",
    "sass-embedded": "^1.99.0",
    "source-map-support": "^0.5.21",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.2",
    "ua-parser-js": "^2.0.9",
    "unplugin-lightningcss": "^0.4.5",
    "unplugin-swc": "^1.5.9",
    "unrun": "^0.3.0",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^4.1.5",
    "vue": "^3.5.34"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.6"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@arkstack/console",
      "argon2",
      "cpu-features",
      "esbuild",
      "ssh2"
    ]
  }
}
